# Files that run on the Raspberry Pi must keep LF endings even when edited on Windows.
*.sh            text eol=lf
aero.config     text eol=lf
server/server.properties text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.mcfunction    text eol=lf
*.mcmeta        text eol=lf
*.py            text eol=lf
*.ps1           text eol=crlf
