# ── Edit these, then run the scripts. No quotes, no spaces around "=" ──

# Your GitHub repo, "owner/name". The pack files must be pushed here (public).
GITHUB_REPO=josephdwebb/MinecraftAero

# Branch the pack lives on.
GITHUB_BRANCH=main

# Minecraft + loader. Change only if you know what you're doing.
MC_VERSION=1.21.1
NEOFORGE_VERSION=latest

# Server (Raspberry Pi) memory. Pi 5 with ~7 GB free: 5G is a sane ceiling.
SERVER_XMX=5G
SERVER_XMS=3G

# What shows up in players' server list, and the address they connect to.
# SERVER_ADDRESS must be a hostname that actually resolves to your public IP
# (set up a free DuckDNS or similar — see README). Include :25565 only if you
# use a non-default port.
SERVER_NAME=Losertown
SERVER_ADDRESS=joe-losertown.duckdns.org
